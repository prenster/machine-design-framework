{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine cycle (timing) diagram",
  "description": "The master document. Every axis is a function of machine angle 0-360 deg; every valve/solenoid has commanded on/off angles plus response delays (ms). Generates PLC cam tables and drives the simulation.",
  "type": "object",
  "required": [
    "axes",
    "valves"
  ],
  "properties": {
    "machine_angle": {
      "type": "string"
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "vmax",
          "amax",
          "segments"
        ],
        "properties": {
          "type": {
            "enum": [
              "servo",
              "mechanical_cam",
              "pneumatic"
            ]
          },
          "unit": {
            "type": "string"
          },
          "drive": {
            "type": "string",
            "description": "Catalog drive/actuator, e.g. 'SEW MOVI-C + CMP63 + linear module'"
          },
          "vmax": {
            "type": [
              "number",
              "string"
            ],
            "description": "units/s, number or param name"
          },
          "amax": {
            "type": [
              "number",
              "string"
            ],
            "description": "units/s^2, number or param name"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "law",
                "from",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "law": {
                  "enum": [
                    "dwell",
                    "cycloidal",
                    "poly5",
                    "linear"
                  ]
                },
                "from": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "to": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "at": {
                  "type": "number",
                  "description": "dwell position"
                },
                "s0": {
                  "type": "number"
                },
                "s1": {
                  "type": "number"
                },
                "v0": {
                  "type": "number",
                  "description": "poly5 start velocity, units/deg"
                },
                "v1": {
                  "type": "number",
                  "description": "poly5 end velocity, units/deg"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "module": {
            "type": "string",
            "description": "BOM id of the linear/rotary module"
          },
          "motor": {
            "type": "string",
            "description": "BOM id of the motor"
          },
          "rides_on": {
            "type": "string",
            "description": "axis this axis is mounted on (its moving mass counts there)"
          },
          "actuation_reason": {
            "type": "string"
          },
          "cam": {
            "type": "object",
            "required": [
              "follower",
              "base_radius_mm",
              "closure"
            ],
            "properties": {
              "follower": {
                "enum": [
                  "translating_roller"
                ]
              },
              "base_radius_mm": {
                "type": "number"
              },
              "roller_radius_mm": {
                "type": "number"
              },
              "offset_mm": {
                "type": "number"
              },
              "closure": {
                "enum": [
                  "force",
                  "form"
                ]
              },
              "spring": {
                "type": "object",
                "properties": {
                  "rate_n_per_mm": {
                    "type": "number"
                  },
                  "preload_n": {
                    "type": "number"
                  }
                }
              },
              "external_load_n": {
                "type": "number"
              },
              "follower_mass_kg": {
                "type": "number"
              },
              "roller_part": {
                "type": "string"
              },
              "cam_part": {
                "type": "string"
              },
              "driven_by": {
                "type": "string"
              },
              "limits": {
                "type": "object",
                "properties": {
                  "pressure_angle_deg": {
                    "type": "number"
                  },
                  "curvature_ratio_min": {
                    "type": "number"
                  },
                  "jump_margin_n": {
                    "type": "number"
                  },
                  "roller_life_h": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "superimposed": {
            "type": "object",
            "required": [
              "tag",
              "blend",
              "range",
              "case_param",
              "return_blend"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "description": "PLC output (REAL) holding the per-cycle offset"
              },
              "blend": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "machine-angle window in which the offset changes"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "case_param": {
                "type": "string",
                "description": "param holding the steady offset used by static checks (set per variant)"
              },
              "note": {
                "type": "string"
              },
              "return_blend": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "window in which the offset returns to 0 (before the next pick)"
              }
            }
          },
          "incremental_pitch": {
            "type": "number",
            "description": "indexing axis: position advances by this much every cycle"
          }
        }
      }
    },
    "valves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "on",
          "off",
          "on_delay",
          "off_delay"
        ],
        "additionalProperties": false,
        "properties": {
          "on": {
            "type": "number"
          },
          "off": {
            "type": "number"
          },
          "on_delay": {
            "type": [
              "number",
              "string"
            ],
            "description": "ms, number or param name"
          },
          "off_delay": {
            "type": [
              "number",
              "string"
            ]
          },
          "device": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "vacuum",
              "glue",
              "blow_off",
              "pneumatic_actuator",
              "other"
            ]
          },
          "actuation_reason": {
            "type": "string"
          }
        }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "check_at"
        ],
        "properties": {
          "check_at": {
            "type": "number"
          },
          "signal": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "park_angle": {
      "type": "number"
    },
    "actuation_preference": {
      "type": "array",
      "items": {
        "enum": [
          "mechanical_cam",
          "servo",
          "pneumatic"
        ]
      }
    }
  }
}